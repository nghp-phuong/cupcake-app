  "talkRosaSecretR1": "Cô bé tinh ý. Đây, tip cho sự kín đáo.",
  "talkRosaSecretC2": "Bà nếm thử đi, kem hôm nay ngon lắm!",
  "talkRosaSecretR2": "(Liếm thật nhanh) …Ngon thật. Đừng kể với ai nhé.",

  "talkMochiBellyL1": "Meo.",
  "talkMochiBellyL2": "Hôm nay em lại ướt sũng à? Lò còn ấm đó, ra hong lông đi.",
  "talkMochiBellyL3": "(Mochi lăn ra, chìa cái bụng tròn mềm.)",
  "talkMochiBellyL4": "Bẫy đấy, chị biết mà. Xoa bụng là bị cắn.",
  "talkMochiBellyC1": "Xoa bụng",
  "talkMochiBellyR1": "(Mochi ôm chặt tay Mai bằng cả bốn chân… và rù rù.)",
  "talkMochiBellyC2": "Lăn cuộn len cho em",
  "talkMochiBellyR2": "(Mochi lao theo cuộn len, trượt một vòng trên sàn gỗ.)",
  "talkMochiBellyL5": "Đúng là đồ mèo con nghịch ngợm.",

  "talkWalrusFishL1": "Cháu đoán xem sáng nay bác câu được con cá to cỡ nào?",
  "talkWalrusFishL2": "To cỡ nào ạ?",
  "talkWalrusFishL3": "To bằng… cái lò nướng của cháu!",
  "talkWalrusFishC1": "Tuần trước bác bảo nó to bằng cái tủ lạnh mà.",
