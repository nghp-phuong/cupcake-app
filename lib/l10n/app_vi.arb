  "storyPrologue1": "Một thị trấn ven biển yên bình. Một tiệm bánh nhỏ với tấm biển đã bạc màu: Sugarleaf.",
  "storyPrologue2": "Bà ơi, cháu về rồi... Từ nay cháu sẽ chăm lo tiệm bánh của bà.",
  "storyPrologue3": "Sổ công thức của bà! Nhưng thiếu nhiều trang quá...",
  "storyPrologue4": "Bắt đầu từ món đơn giản thôi. Cupcake nào!",
  "storyHoa1Line1": "Tiệm Sugarleaf lại sáng đèn rồi. Cháu là bé Mai phải không?",
  "storyHoa1Line2": "Dạ! Ông quen bà cháu ạ?",
  "storyHoa1Line3": "Chủ nhật nào ông cũng ghé, suốt bốn mươi năm. Tart trứng của bà... ông vẫn nhớ mãi.",
  "storyHoa1Line4": "Vậy cháu sẽ học làm cho ông. Cháu hứa đấy ạ!",
  "storyLinh1Line1": "Chào chị! Em là Linh, học trường mỹ thuật trên đồi.",
  "storyLinh1Line2": "Em vẽ lại mọi chiếc bánh em ăn. Tiệm chị dễ thương xỉu luôn!",
  "storyLinh1Line3": "Vậy chị phải làm bánh thật xinh cho em vẽ rồi!",
  "storyHoa2Line1": "Ông Hòa ơi! Hôm nay cháu tìm được trang tart trứng rồi.",
  "storyHoa2Line2": "Vậy hôm nay là ngày đẹp trời. Để xem tay cháu có nhớ bà không nào.",
  "storyHoa2Line3": "Cháu sẽ cố hết sức!",
  "storyKenji1Line1": "Xin chào. Tôi là Kenji. Tôi đi khắp nơi chụp ảnh những thị trấn nhỏ.",
  "storyKenji1Line2": "Tôi không chắc mình muốn gì. Món gì đó giống một buổi sáng đầy nắng?",
  "storyKenji1Line3": "Buổi sáng đầy nắng... Chắc là bánh kem dâu!",
  "storyLinh2Line1": "Chị Mai ơi, chị làm macaron được không? Em mê vẽ macaron nhất!",
  "storyLinh2Line2": "Món này khó lắm... nhưng mình cùng thử nhé.",
  "storyLinh2Line3": "Yeah! Chị làm bánh, em ngồi ký họa!",
  "storyKenji2Line1": "Sáng mai tôi sẽ leo ngọn hải đăng lúc bình minh. Tôi cần chút can đảm.",
  "storyKenji2Line2": "Can đảm thì đậm đà và ngọt nhẹ. Red velvet nhé!",
  "storyKenji2Line3": "Cô đọc cảm xúc như đọc công thức vậy.",
  "storyHoa3Line1": "Ông mang cái này đến. Năm xưa bà nhờ ông giữ hộ trang này.",
  "storyHoa3Line2": "Chữ của bà... Cháu cảm ơn ông.",
  "storyHoa3Line3": "Nó thuộc về căn bếp này. Cũng như cháu vậy.",
  "storyLinh3Line1": "Chị xem! Tranh em vẽ tiệm chị được giải ở trường đó!",
  "storyLinh3Line2": "Đẹp quá Linh ơi! Chị treo cạnh cửa sổ nhé?",
  "storyLinh3Line3": "Với điều kiện mình ăn mừng bằng bánh kem matcha!",
  "storyKenji3Line1": "Ảnh tôi chụp thị trấn này sẽ được trưng bày ở Tokyo.",
  "storyKenji3Line2": "Tôi muốn nhớ về nơi này bằng một món dịu dàng mà đậm vị.",
  "storyKenji3Line3": "Vậy là cheesecake, thêm việt quất xanh như biển.",
  "storyFinaleLine1": "Ông Hòa, Linh, Kenji... tiệm bánh lại rộn ràng như xưa.",
  "storyFinaleLine2": "Sổ của bà vẫn còn những trang trống. Cháu sẽ viết tiếp, từng trang một.",
  "storyCh1End1": "Những trang đầu của sổ bà lại đầy ắp rồi.",
  "storyCh1End2": "Thị trấn bắt đầu biết đến cupcake của mình rồi... Phải bận rộn hơn thôi!",
  "storyCh2End3": "Và ngay sau cánh cửa sau, một chương mới đang chờ...",
  "storyCh3Open1": "Sau tiệm, khu vườn của bà mọc um tùm bạc hà và hoa hồng leo.",
  "storyCh3Open2": "Dưới đám lá này có gì nhỉ? Một nhà kho nhỏ xinh!",
  "storyCh3Open3": "Một trang sổ của bà nằm trong chậu hoa: \"Bánh sừng bò. Gấp bơ vào bột, và kiên nhẫn nhé.\"",
  "storyCh3Open4": "Mai phủi đất, mỉm cười. Khu vườn đã giữ bí mật của bà thật kỹ.",
  "storyMochi1Line1": "Mưa rơi lộp độp trên mái hiên. Dưới đó, một chú mèo xám nhỏ ngồi im thật im.",
  "storyMochi1Line2": "Ôi! Em ướt sũng rồi, bé con. Vào đây đi, lò đang ấm lắm.",
  "storyMochi1Line3": "Chú mèo cuộn tròn cạnh quầy, rù rù như một chiếc máy nhỏ.",
  "storyMochi1Line4": "Chị đặt tên em là Mochi nhé. Hễ trời mưa là ghé chơi, được không?",
  "storyKenji4Line1": "Hôm nay tôi muốn một món... cho ngày nhớ nhà.",
  "storyKenji4Line2": "Vậy là món nhỏ và ấm nhé. Như cái ôm từ phương xa.",
  "storyKenji4Line3": "Madeleine. Bà bảo chỉ một miếng cũng gợi lại cả buổi chiều.",
  "storyKenji4Line4": "Vậy tôi sẽ ăn thật chậm.",
  "storyCh4Open1": "Trên gác, bụi nhảy múa trong ánh sáng từ ô cửa sổ tròn nhỏ.",
  "storyCh4Open2": "Hộp thư cũ của bà... bà giữ từng lời nhắn khách đã viết.",
  "storyCh4Open3": "Và thêm hai trang nữa: éclair, và tart trái cây \"cho những ngày nắng\".",
  "storyCh4Open4": "Mai gài các trang vào sổ. Giờ cuốn sổ nặng hơn một chút, theo cách đáng yêu nhất.",
  "storyRosa1Line1": "Chào cháu. Bà cháu từng nướng bánh cưới cho bà đấy.",
  "storyRosa1Line2": "Giờ cháu gái bà sắp cưới, ngay bên bờ biển.",
  "storyRosa1Line3": "Bà Rosa ơi, tin vui quá ạ!",
  "storyRosa1Line4": "Đến ngày, bà sẽ đặt bánh của cháu cho con bé. Bà cháu sẽ vui lắm.",
  "storyLinh4Line1": "Chị Mai! Tuần sau trường có hội chợ, em đăng ký gian hàng cho hai đứa rồi!",
  "storyLinh4Line2": "Hai đứa á? Mình bán gì đây?",
  "storyLinh4Line3": "Bánh táo! Ai mang một cái là cả trường thơm mùi quế.",
  "storyLinh4Line4": "Vậy mình sẽ nướng lớp lưới xinh nhất thị trấn. Theo cách của bà.",
  "storyCh5Open1": "Đèn lồng được treo khắp bến cảng. Lễ hội biển sắp đến rồi.",
  "storyCh5Open2": "Cả thị trấn đang trang hoàng... và ai cũng hỏi về bánh Trung thu.",
  "storyCh5Open3": "Sổ của bà cũng có trang cho món đó: nhân sen và khuôn hoa nhỏ.",
  "storyCh5Open4": "Tối nay tiệm bánh sẽ sáng như một chiếc đèn lồng nữa bên biển.",
  "storyHoa4Line1": "Mỗi mùa đông, bà cháu nướng một khúc cây sô-cô-la cho cả xóm.",
  "storyHoa4Line2": "Nấm meringue bé xíu, tuyết đường phủ nhẹ... lũ trẻ mê lắm.",
  "storyHoa4Line3": "Bánh khúc cây Giáng sinh ạ? Cháu chưa làm bao giờ.",
  "storyHoa4Line4": "Rồi cháu sẽ làm được. Tay bà đang ở trong tay cháu đấy, ông nhìn là biết.",
  "storyRosa2Line1": "Hôm nay đám cưới rồi cháu. Bánh xong chưa?",
  "storyRosa2Line2": "Sắp xong ạ. Ba tầng, gói như một món quà, giống chiếc bà đã làm cho bà.",
  "storyRosa2Line3": "Ôi... cháu gái bà sẽ khóc mất. Có khi bà cũng khóc.",
  "storyRosa2Line4": "Vậy mình làm cho xứng từng giọt nước mắt hạnh phúc nhé.",
  "storyFinale2Line1": "Trang trống cuối cùng trong sổ của bà cuối cùng đã được lấp đầy.",
  "storyFinale2Line2": "Tiệm bánh lại ấm áp và rộn ràng, đầy bạn bè cùng câu chuyện của họ.",
  "storyFinale2Line3": "Nhưng một tiệm bánh hay thì không bao giờ hết chuyện... còn nhiều chương nữa đang chờ.",

